#!/usr/bin/env bash
# Check the staged content, not unstaged edits. Installed by make hooks.
set -euo pipefail

if ! command -v gitleaks &>/dev/null; then
    echo "gitleaks not found; commit blocked. Install gitleaks, then retry." >&2
    exit 1
fi

staged_dir=$(mktemp -d)
trap 'rm -rf "$staged_dir"' EXIT
git diff --cached --name-only -z --diff-filter=ACMRT > "$staged_dir/paths"

while IFS= read -r -d '' file; do
    if git check-ignore --no-index -q -- "$file"; then
        printf 'Commit blocked: %s is marked local-only by gitignore.\n' "$file" >&2
        exit 1
    else
        ignore_status=$?
        [[ "$ignore_status" -eq 1 ]] || exit "$ignore_status"
    fi

    case "$file" in
        zed/*settings.json)
            git show ":$file" > "$staged_dir/zed.json"
            if grep -Eq '"(ssh_connections|remote)"[[:space:]]*:' "$staged_dir/zed.json"; then
                printf 'Commit blocked: %s contains Zed server settings. Keep them in machine-local global_settings.json.\n' "$file" >&2
                exit 1
            fi
            ;;
        *.sh|hooks/pre-commit|hooks/pre-push)
            if command -v shellcheck &>/dev/null; then
                git show ":$file" > "$staged_dir/staged.sh"
                printf 'shellcheck: %s\n' "$file"
                shellcheck "$staged_dir/staged.sh"
            fi
            ;;
        *.fish)
            if command -v fish &>/dev/null; then
                git show ":$file" > "$staged_dir/staged.fish"
                printf 'fish syntax: %s\n' "$file"
                fish --no-execute "$staged_dir/staged.fish"
            fi
            ;;
    esac
done < "$staged_dir/paths"

# Includes default token/key rules, IPv4 addresses, and Zed server settings.
gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
