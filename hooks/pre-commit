#!/usr/bin/env bash
# Pre-commit hook: lint shell scripts and block secrets
# Installed by: git config core.hooksPath hooks

# Collect staged .sh and .fish files
staged_sh="$(git diff --cached --name-only --diff-filter=ACM -- '*.sh')"
staged_fish="$(git diff --cached --name-only --diff-filter=ACM -- '*.fish')"

# Shellcheck staged .sh files
if [[ -n "$staged_sh" ]] && command -v shellcheck &>/dev/null; then
    echo "shellcheck: checking staged scripts ..."
    echo "$staged_sh" | xargs shellcheck || exit 1
fi

# Fish syntax check staged .fish files
if [[ -n "$staged_fish" ]] && command -v fish &>/dev/null; then
    echo "fish: checking staged scripts ..."
    echo "$staged_fish" | xargs fish --no-execute || exit 1
fi

# Block machine-local Zed settings that must stay out of the public repo.
# Zed writes ssh_connections into settings.json when you add a remote server
# via `project: Open Remote`. Keep those in ~/.config/zed/global_settings.json.
staged_zed="$(git diff --cached --name-only --diff-filter=ACM -- zed | grep 'settings\.json$')"
if [[ -n "$staged_zed" ]]; then
    for f in $staged_zed; do
        if git show ":$f" | grep -qE '^[[:space:]]*"(ssh_connections|remote)"[[:space:]]*:'; then
            echo "❌ $f contains ssh_connections — commit blocked"
            echo "  Move it to ~/.config/zed/global_settings.json (machine-local, not stowed)"
            exit 1
        fi
    done
fi

# Gitleaks secret scan
if ! command -v gitleaks &>/dev/null; then
    echo "❌ gitleaks not found — commit blocked"
    echo "  Install: brew install gitleaks (macOS) or see https://github.com/gitleaks/gitleaks"
    exit 1
fi

gitleaks protect --staged --verbose --config .gitleaks.toml
