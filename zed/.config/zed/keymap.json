// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    // Git-Panel auf cmd-g. Muss in Workspace UND Pane stehen: der Default
    // bindet cmd-g im Pane-Kontext auf search::SelectNextMatch, und der
    // tiefere Kontext gewinnt. Ersatz fuer next-match: n / N im Vim-Normal-
    // Modus, enter / shift-enter in der Suchleiste.
    "context": "Workspace",
    "bindings": {
      "cmd-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      // "j k": ["workspace::SendKeystrokes", "escape"]
    }
  }
