# Secrets - never commit
secrets.fish
gh/.config/gh/hosts.yml
.DS_Store
*.swp
*.swo
fish_variables

# Machine-local settings, server connections, and authentication state
zed/.config/zed/global_settings.json
zed/.config/zed/settings_backup.json
.ssh/
.gitconfig.local
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
claude/.claude/settings.local.json
claude/.claude/.credentials.json
codex/.codex/auth.json

# Claude Code session data (not the stow package claude/.claude/)
/.claude/

# Local-only symlinks (point to paths outside this repo)
fish/.config/fish/functions/kaffee.fish
fish/.config/fish/functions/plug.fish
fish/.config/fish/functions/_plug_wait_output.fish

# Generated from templates by setup.sh (contain user-specific info)
claude/.claude/CLAUDE.md
codex/.codex/AGENTS.md

# Codex auto-generated state
codex/.codex/config.toml
codex/.codex/skills/.system/

# Editor and installer leftovers (contain absolute paths)
*.bak
*.bak.*
__pycache__/
*.pyc

# Skills are local by default (installers, system skills, and private instructions).
# To publish a custom skill, review it and add an exception here first.
claude/.claude/skills/*
!claude/.claude/skills/agent-browser/
!claude/.claude/skills/apple-mail-search/
!claude/.claude/skills/audio-transcriber/
